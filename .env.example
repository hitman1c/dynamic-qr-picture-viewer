# Public URL of the picture API (Neon Data API REST endpoint). No secrets in this URL.
# Leave both API variables empty to run in local-only demo mode (QR works on this device only).
VITE_NEON_DATA_API_URL=

# URL of the Managed Better Auth service used to obtain anonymous API tokens.
# Must be set together with VITE_NEON_DATA_API_URL.
VITE_NEON_AUTH_URL=

# Absolute base URL of the deployed app, used to build QR destination links.
# Example: https://your-app.netlify.app
# Leave empty to use the current browser origin.
VITE_APP_BASE_URL=
